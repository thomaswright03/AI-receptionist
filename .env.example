# Public URL of this service (Fly.io), used for Twilio callbacks and Vapi tool calls.
PUBLIC_URL=https://ai-receptionist.fly.dev
PORT=8080
# Shown on /admin/status.json. Set to the commit at deploy, e.g. fly deploy --env APP_VERSION=$(git rev-parse --short HEAD)
APP_VERSION=dev

# Vapi: same value as the server secret set on the Vapi phone number / assistant.
VAPI_SECRET=
# Required when DRY_RUN=false (the service refuses /vapi without it)
STATE_FILE=/data/state.json
ADMIN_SECRET=
# Live-call model. Small and fast; must be on Vapi's supported model list.
VAPI_MODEL_PROVIDER=anthropic
VAPI_MODEL=claude-haiku-4-5-20251001
VAPI_TWILIO_INBOUND_URL=https://api.vapi.ai/twilio/inbound_call

# Twilio (texts + webhook signatures).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Cal.com: optional key (higher rate limit). Booking itself works on a public event.
CAL_API_KEY=

# Email alerts to the owner (Resend).
RESEND_API_KEY=
EMAIL_FROM=AI Receptionist <receptionist@wright-ai-solutions.com>

# Week 1 runs the stub agent (discloses and hands off only). Switch to full in week 2.
AGENT_MODE=stub

# Safety. DRY_RUN=true logs texts and emails instead of sending them.
DRY_RUN=true
KILL_SWITCH=off
# Optional remote pause flag returning {"paused": false}; unreachable = paused.
KILL_SWITCH_URL=
# URLs the watchdog checks every minute (comma-separated). Empty = off.
WATCHDOG_URLS=

# Wright AI Solutions
WRIGHT_AI_NUMBER=+1XXXXXXXXXX
OWNER_PHONE_WRIGHT_AI=+1XXXXXXXXXX
OWNER_EMAIL_WRIGHT_AI=
CAL_LINK_WRIGHT_AI=https://cal.com/<username>/<phone-event-slug>

# Mountain High Disposal (second pilot; off until its number is set)
MOUNTAIN_HIGH_NUMBER=
OWNER_PHONE_MOUNTAIN_HIGH=
OWNER_EMAIL_MOUNTAIN_HIGH=
MOUNTAIN_HIGH_TIME_ZONE=America/Denver
